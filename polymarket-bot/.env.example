# ─── Polymarket CLOB API credentials ─────────────────────────────────────────
# Generate at: https://docs.polymarket.com → API Keys
# Sign the request with your MetaMask / Coinbase wallet.
POLY_API_KEY=
POLY_API_SECRET=
POLY_API_PASSPHRASE=

# Your wallet private key (starts with 0x)
# Export from MetaMask: Settings → Security & Privacy → Export Private Key
# NEVER commit this file.  Add .env to .gitignore.
POLY_PRIVATE_KEY=

# ─── Alchemy RPC (Polygon Mainnet) ───────────────────────────────────────────
# Create a free app at https://alchemy.com → Polygon Mainnet → copy HTTPS URL
ALCHEMY_RPC_URL=

# ─── Telegram alerts ─────────────────────────────────────────────────────────
# 1. Message @BotFather on Telegram → /newbot → copy token
# 2. Send any message to your new bot, then run:
#    curl "https://api.telegram.org/bot<TOKEN>/getUpdates"
#    and copy the chat_id from the response.
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=
